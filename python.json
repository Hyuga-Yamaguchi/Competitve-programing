  "eratosthenes": {
    "prefix": "eratosthenes",
    "body": [
      "def eratosthenes(n, to_set=False):",
      "    isprime = [True] * (n + 1)",
      "",
      "    isprime[0] = False",
      "    isprime[1] = False",
      "",
      "    for p in range(2, n + 1):",
      "        if not isprime[p]:",
      "            continue",
      "        q = p * 2",
      "        while q <= n:",
      "            isprime[q] = False",
      "            q += p",
      "",
      "    l = [i for i, _ in enumerate(isprime) if isprime[i]]",
      "",
      "    return set(l) if to_set else l",
      ""
    ]
