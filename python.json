  "combination": {
    "prefix": "combination",
    "body": [
      "def factorial(n, m):",
      "    result = 1",
      "    for i in range(1, n + 1):",
      "        result = (result * i) % m",
      "    return result",
      "",
      "",
      "def combination(n, r, m):",
      "    if r < 0 or r > n:",
      "        return 0",
      "",
      "    num = factorial(n, m)",
      "    den = factorial(r, m) * factorial(n - r, m) % m",
      "",
      "    return num * pow(den, -1, m) % m",
      ""
    ]
  },
