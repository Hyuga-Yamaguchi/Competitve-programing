  "interval_scheduling": {
    "prefix": "interval_scheduling",
    "body": [
      "def interval_scheduling(arr):",
      "    arr.sort(key=lambda x: x[1])",
      "    count = 1",
      "    cur_end = arr[0][1]",
      "",
      "    for l, r in arr[1:]:",
      "        if cur_end <= l:",
      "            count += 1",
      "            cur_end = r",
      "",
      "    return count",
