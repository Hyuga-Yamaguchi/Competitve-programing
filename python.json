  "bit_search": {
    "prefix": "bit_search",
    "body": [
      "def bit_search(arr, to_set=False):",
      "    n = len(arr)",
      "    return [",
      "        (",
      "            {arr[j] for j in range(n) if i >> j & 1}",
      "            if to_set",
      "            else [arr[j] for j in range(n) if i >> j & 1]",
      "        )",
      "        for i in range(1 << n)",
      "    ]",
